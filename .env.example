# Copy to .env and fill in. All are free-tier.

# --- LLM backend (Groq free tier, via LiteLLM) ---------------------------
# Get a free key at https://console.groq.com/keys (personal login, no billing).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Local runs (no Docker): scorer talks straight to Groq (OpenAI-compatible).
LITELLM_BASE_URL=https://api.groq.com/openai/v1
# Docker proxy auth (n8n -> litellm); the real provider key stays in GROQ_API_KEY.
LITELLM_MASTER_KEY=sk-local

# Optional Gemini fallback (needs a free-tier-enabled Google account):
GEMINI_API_KEY=

# --- PageSpeed Insights (free) -------------------------------------------
# Enable "PageSpeed Insights API" in Google Cloud, create an API key.
PSI_API_KEY=

# --- Google Search Console + GA4 (free, service account) -----------------
# Drop the service-account JSON at ./secrets/service-account.json
# and grant its email access to the GSC property + GA4 property.
GSC_SITE_URL=https://www.example.com/
GA4_PROPERTY_ID=
