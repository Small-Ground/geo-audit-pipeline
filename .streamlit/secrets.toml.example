# Streamlit Community Cloud — paste these into the app's "Secrets" box
# (App → Settings → Secrets). Locally you can instead use .env.
# Do NOT commit a real secrets.toml (it's git-ignored).

GROQ_API_KEY = "gsk_your_groq_key"
LLM_MODEL = "llama-3.3-70b-versatile"
LITELLM_BASE_URL = "https://api.groq.com/openai/v1"

# scorer uses this as the bearer when talking straight to Groq
LITELLM_API_KEY = "gsk_your_groq_key"

# optional
PSI_API_KEY = ""
